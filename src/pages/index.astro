---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Features from "../components/Features.astro";
import HomeSeoSections from "../components/HomeSeoSections.astro";
import Pricing from "../components/Pricing.astro";
import Reviews from "../components/Reviews.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { deFaq, deSingleScreenPlans } from "../data/de";
import { site } from "../data/site";
import "../styles/global.css";

const title = "IPTV Schweiz: IPTV Abo für Smart TV & IPTV Box | Schweiz IPTV";
const description =
  "IPTV Schweiz für Smart TV, Android, iOS, Fire TV und IPTV Box: Abo in CHF mit HD/FHD/4K, Replay, VOD, Multi-Screen, WhatsApp-Support und 48h Garantie.";
const imageAlt =
  "IPTV Schweiz auf Smart TV: Schweiz IPTV Abo mit HD, 4K, Replay, VOD und Schweizer Sendern";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: site.name,
      url: site.url,
      email: site.email,
      logo: `${site.url}/logo-new.svg`,
      contactPoint: {
        "@type": "ContactPoint",
        telephone: site.whatsapp,
        contactType: "customer support",
        availableLanguage: ["de", "de-CH", "fr", "fr-CH"],
      },
    },
    { "@type": "WebSite", name: site.name, url: site.url, inLanguage: "de-CH" },
    {
      "@type": "Service",
      name: "IPTV Abo Schweiz",
      provider: { "@type": "Organization", name: site.name, url: site.url },
      areaServed: { "@type": "Country", name: "Schweiz" },
      serviceType: "IPTV",
      image: `${site.url}/hero-iptv-suisse-1280.webp`,
      offers: deSingleScreenPlans.map((plan) => ({
        "@type": "Offer",
        name: plan.name,
        price: plan.priceChf,
        priceCurrency: "CHF",
        availability: "https://schema.org/InStock",
        url: `${site.url}/#${plan.id}`,
      })),
    },
    {
      "@type": "FAQPage",
      mainEntity: deFaq.map((item) => ({
        "@type": "Question",
        name: item.q,
        acceptedAnswer: { "@type": "Answer", text: item.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} lang="de-CH" imageAlt={imageAlt} preloadHero>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header />

  <main>
    <section class="hero" id="accueil">
      <picture>
        <source
          type="image/webp"
          srcset="/hero-iptv-suisse-480.webp 480w, /hero-iptv-suisse-768.webp 768w, /hero-iptv-suisse-960.webp 960w, /hero-iptv-suisse-1280.webp 1280w"
          sizes="100vw"
        />
        <img
          src="/hero-iptv-suisse-1280.jpg"
          srcset="/hero-iptv-suisse-480.jpg 480w, /hero-iptv-suisse-768.jpg 768w, /hero-iptv-suisse-960.jpg 960w, /hero-iptv-suisse-1280.jpg 1280w"
          sizes="100vw"
          width="1280"
          height="720"
          alt={imageAlt}
          decoding="async"
          fetchpriority="high"
          loading="eager"
        />
        <figcaption class="sr-only">
          Hauptbild IPTV Schweiz: Smart TV mit IPTV Oberfläche, HD/FHD/4K Inhalte, modernes Schweizer Wohnzimmer und Blick auf die Berge.
        </figcaption>
      </picture>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <p class="eyebrow">IPTV Schweiz</p>
        <h1>IPTV Schweiz: Abo auf Deutsch für Smart TV, Android und IPTV Box</h1>
        <p class="hero-copy">
          Wählen Sie ein IPTV Abo Schweiz in CHF mit Premium-Server, Replay, VOD, HD, FHD und 4K Qualität sowie Support 24/7 per WhatsApp.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#les-offres">IPTV Angebote ansehen</a>
        </div>
      </div>
    </section>

    <Features />
    <Pricing />
    <Reviews />
    <HomeSeoSections />
  </main>

  <Footer />
</BaseLayout>
