---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="IPTV Deutschschweiz | IPTV Abo auf Deutsch" description="IPTV Deutschschweiz mit deutschsprachigem Support für Zürich, Bern, Basel, Luzern, St. Gallen, Aargau und die ganze Schweiz." canonical="/iptv-deutschschweiz/" lang="de-CH">
  <Header />
  <main>
    <section class="page-hero">
      <p class="eyebrow">IPTV Deutschschweiz</p>
      <h1>IPTV Abo auf Deutsch für die Deutschschweiz</h1>
      <p>Deutschsprachige Beratung für Nutzer in Zürich, Bern, Basel, Luzern, St. Gallen, Aargau und der ganzen Schweiz.</p>
      <a class="button primary" href={site.whatsappUrl}>Support kontaktieren</a>
    </section>
  </main>
  <Footer />
</BaseLayout>
