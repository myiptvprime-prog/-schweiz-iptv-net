---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="AGB | IPTV Abo Schweiz" description="AGB Schweiz IPTV: IPTV Abos Schweiz, Aktivierung, Kompatibilität, 48h Garantie, Support und Verfügbarkeit von Inhalten." canonical="/agb/" lang="de-CH">
  <Header />
  <main>
    <section class="page-hero legal-hero"><p class="eyebrow">Allgemeine Geschäftsbedingungen</p><h1>AGB</h1><p>Diese Bedingungen beschreiben die wichtigsten Regeln für Schweiz IPTV Abos, Multi-Screen-Angebote, Support und 48h Zufriedenheitsgarantie.</p></section>
    <section class="section legal-page">
      <article><h2>Leistungsgegenstand</h2><p>Schweiz IPTV bietet IPTV Abos in der Schweiz für kompatible Geräte wie Smart TV, Android, iOS/tvOS, Windows, Fire TV und IPTV Boxen.</p></article>
      <article><h2>Preise und Laufzeit</h2><p>Preise werden in CHF angezeigt. Angebote können eine Hauptlaufzeit und je nach Aktion zusätzliche Gratismonate enthalten.</p></article>
      <article><h2>Aktivierung</h2><p>Nach Bestätigung der Bestellung werden die Zugangsdaten per E-Mail oder über den vereinbarten Kontaktkanal gesendet. Die Aktivierung kann bis zu 15 Minuten dauern.</p></article>
      <article><h2>Kompatibilität</h2><p>Der Kunde benötigt eine stabile Internetverbindung und ein kompatibles Gerät. Vor Aktivierung sollte die passende App geprüft werden.</p></article>
      <article><h2>Verfügbarkeit der Inhalte</h2><p>Sender, Filme, Serien, Sport, Replay und VOD können je nach Abo, technischer Verfügbarkeit und geltenden Rechten variieren.</p></article>
      <article><h2>Support</h2><p>Der Support ist per WhatsApp und E-Mail erreichbar.</p><div class="legal-actions"><a class="button primary" href={site.whatsappUrl}>WhatsApp</a><a class="button secondary" href={`mailto:${site.email}`}>E-Mail</a></div></article>
    </section>
  </main>
  <Footer />
</BaseLayout>
