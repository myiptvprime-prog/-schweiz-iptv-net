---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Kontakt IPTV Schweiz | WhatsApp und E-Mail" description="Kontaktieren Sie Schweiz IPTV per WhatsApp oder E-Mail, um Ihr Gerät zu prüfen, Beratung zu erhalten und ein IPTV Abo Schweiz zu wählen." canonical="/kontakt/" lang="de-CH">
  <Header />
  <main>
    <section class="page-hero">
      <p class="eyebrow">Kontakt IPTV Schweiz</p>
      <h1>Kontakt per WhatsApp und E-Mail</h1>
      <p>Verfügbar 24h/24, 7 Tage die Woche, auch an Feiertagen.</p>
      <a class="button primary" href={site.whatsappUrl}>WhatsApp {site.whatsapp}</a>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </section>
  </main>
  <Footer />
</BaseLayout>
