---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../data/site";
import "../../styles/global.css";
---

<BaseLayout title="Contact IPTV Suisse | WhatsApp et e-mail" description="Contactez Schweiz IPTV par WhatsApp ou e-mail pour vérifier votre appareil, demander conseil et choisir votre abonnement IPTV Suisse.">
  <Header />
  <main>
    <section class="page-hero">
      <p class="eyebrow">Contact IPTV Suisse</p>
      <h1>Contact WhatsApp et e-mail</h1>
      <p>Disponible 24h/24, 7j/7, y compris les jours fériés.</p>
      <div class="hero-actions">
        <a class="button primary" href={site.whatsappUrl}>WhatsApp {site.whatsapp}</a>
        <a class="button secondary" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
