---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { deChannelGroups } from "../data/de";
import { site } from "../data/site";
---

<BaseLayout title="IPTV Sender Schweiz | Replay, VOD und Kategorien" description="Entdecken Sie IPTV Sender Schweiz: Deutschschweiz, Romandie, Sport, Filme, Serien, Kinder, Dokumentationen, Nachrichten, Replay und VOD je nach Abo." canonical="/sender/" lang="de-CH">
  <Header />
  <main>
    <section class="page-hero">
      <p class="eyebrow">IPTV Sender Schweiz</p>
      <h1>Sender, Replay und VOD für Ihr IPTV Abo Schweiz</h1>
      <p>Ein gutes IPTV Angebot ist übersichtlich, stabil und nützlich. Wir strukturieren die Sender nach Sprache, Land und Nutzung, damit Sie vor dem Abo besser vergleichen können.</p>
      <a class="button primary" href={site.whatsappUrl}>Sender anfragen</a>
    </section>
    <section class="section channels">
      <div class="channel-grid large">
        {deChannelGroups.map(([title, text]) => (
          <article>
            <h2>{title}</h2>
            <p>{text}</p>
          </article>
        ))}
      </div>
      <div class="notice">
        Sender, Pakete, Sportinhalte, Replay und VOD können je nach Abo, technischer Verfügbarkeit und geltenden Rechten variieren.
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
