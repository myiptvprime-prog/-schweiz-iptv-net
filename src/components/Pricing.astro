---
import { singleScreenPlans, site } from "../data/site";
import { deSingleScreenPlans } from "../data/de";

interface Props {
  variant?: "fr-home";
}

const { variant } = Astro.props;
const isDe = !Astro.url.pathname.startsWith("/fr/");
const isFrenchHomePricing = variant === "fr-home" && !isDe;
const activeSinglePlans = isDe ? deSingleScreenPlans : singleScreenPlans;
const orderPlans = activeSinglePlans.map((plan) => ({
  id: plan.id,
  name: plan.name,
  duration: plan.duration,
  priceChf: plan.priceChf,
  price: plan.price,
}));

const monthlyPrice = (priceChf: number, includedMonths: number) =>
  isDe ? `≈ ${(priceChf / includedMonths).toFixed(2)} CHF / Monat` : `≈ ${(priceChf / includedMonths).toFixed(2)} CHF / mois`;
const singlePlanLabel = (planName: string) =>
  isDe ? `IPTV Abo bestellen: ${planName}` : `Commander cet abonnement IPTV: ${planName}`;
---

<section class:list={["section", "pricing", { "fr-home-pricing": isFrenchHomePricing }]} id="abonnements">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "IPTV Abos Schweiz" : "Nos abonnements Schweiz IPTV"}</p>
    <h2>{isDe ? "IPTV Abo Schweiz: Angebote in CHF" : "Abonnements IPTV Suisse en CHF"}</h2>
    <p>{isDe ? "Vergleichen Sie Laufzeit, enthaltenen Katalog und den monatlichen Preis. Alle Abos enthalten dieselben Vorteile; nur Dauer und Preis unterscheiden sich." : "Comparez les offres en CHF selon la durée, le catalogue inclus et le prix mensuel équivalent. Tous les abonnements incluent les mêmes avantages; seuls la durée et le prix changent."}</p>
  </div>

  <div class="section-title offer-title" id="les-offres">
    <p class="eyebrow">{isDe ? "Angebote" : "Les offres"}</p>
    <h2>{isDe ? "IPTV Angebote" : "Les offres"}</h2>
    <p>{isDe ? "Ein IPTV Abo Schweiz für Smart TV, Android, iOS, Windows, Fire TV und IPTV Box, mit Replay, VOD, Support per WhatsApp und ohne automatische Verlängerung." : "Un abonnement IPTV Suisse pensé pour Smart TV, Android, iOS, Windows, Fire TV et boîtier IPTV, avec replay, VOD, support WhatsApp et sans renouvellement automatique."}</p>
  </div>

  <div class="pricing-grid">
    {activeSinglePlans.map((plan) => (
      <article id={plan.id} class:list={["price-card", { featured: plan.popular }]}>
        <p class="badge">{plan.badge}</p>
        <h3>{plan.name}</h3>
        <div class="price-line">
          <p class="price">{plan.price}</p>
          <span class="discount">{plan.discount}</span>
        </div>
        <p class="monthly-price">{monthlyPrice(plan.priceChf, plan.includedMonths)}</p>
        <p class="muted">{plan.duration} - {plan.channels}</p>
        <ul>
          {plan.features.map((feature) => <li>{feature}</li>)}
        </ul>
        <button class="button primary order-trigger" type="button" data-plan-id={plan.id} aria-label={singlePlanLabel(plan.name)}>
          {isDe ? "Abo auswählen" : "Choisir ce forfait"}
        </button>
      </article>
    ))}
  </div>

  <p class="guarantee">{isDe ? "48 Stunden Zufriedenheitsgarantie. Die Bestellung wird über WhatsApp vorbereitet; die Zahlung erfolgt erst nach den echten Zahlungsschritten." : "Garantie satisfait ou remboursé 48h. La demande est préparée via WhatsApp; le paiement suit uniquement les étapes de paiement réelles."}</p>

  <div class="order-modal" id="order-modal" hidden>
    <div class="order-backdrop" data-order-close></div>
    <div class="order-dialog" role="dialog" aria-modal="true" aria-labelledby="order-title">
      <button class="order-close" type="button" data-order-close aria-label={isDe ? "Formular schliessen" : "Fermer le formulaire"}>×</button>
      <div class="section-title order-heading">
        <p class="eyebrow">{isDe ? "Bestellung vorbereiten" : "Préparer la commande"}</p>
        <h2 id="order-title">{isDe ? "IPTV Abo per WhatsApp bestellen" : "Commander votre abonnement IPTV via WhatsApp"}</h2>
        <p>{isDe ? "Füllen Sie die Angaben aus. Danach öffnet WhatsApp mit Ihrer vorbereiteten Bestellung." : "Renseignez vos informations. WhatsApp s'ouvrira ensuite avec votre commande préparée."}</p>
      </div>

      <form class="order-form" id="order-form" novalidate>
        <label>
          <span>{isDe ? "E-Mail-Adresse" : "Adresse e-mail"}</span>
          <input type="email" name="email" autocomplete="email" required placeholder="name@example.com" />
        </label>

        <label>
          <span>{isDe ? "Ausgewähltes Abo" : "Abonnement sélectionné"}</span>
          <select name="plan" required>
            {orderPlans.map((plan) => <option value={plan.id}>{plan.name} - {plan.duration} - {plan.price}</option>)}
          </select>
        </label>

        <label>
          <span>{isDe ? "Anzahl" : "Quantité"}</span>
          <input type="number" name="quantity" min="1" step="1" value="1" required />
        </label>

        <fieldset>
          <legend>{isDe ? "Zahlungsmethode" : "Mode de paiement"}</legend>
          <label><input type="radio" name="payment" value="PayPal" required /> PayPal</label>
          <label><input type="radio" name="payment" value="Credit or debit card" /> {isDe ? "Kredit- oder Debitkarte" : "Carte de crédit ou de débit"}</label>
          <label><input type="radio" name="payment" value="Bank transfer" /> {isDe ? "Banküberweisung" : "Virement bancaire"}</label>
        </fieldset>

        <div class="order-summary" aria-live="polite">
          <div><span>{isDe ? "Abo" : "Abonnement"}</span><strong data-summary="name"></strong></div>
          <div><span>{isDe ? "Dauer" : "Durée"}</span><strong data-summary="duration"></strong></div>
          <div><span>{isDe ? "Einzelpreis" : "Prix unitaire"}</span><strong data-summary="unit"></strong></div>
          <div><span>{isDe ? "Anzahl" : "Quantité"}</span><strong data-summary="quantity"></strong></div>
          <div class="order-total"><span>{isDe ? "Total" : "Total"}</span><strong data-summary="total"></strong></div>
        </div>

        <p class="form-error" id="order-error" role="alert" hidden></p>
        <button class="button primary" type="submit">{isDe ? "Weiter zu WhatsApp" : "Continuer vers WhatsApp"}</button>
      </form>
    </div>
  </div>

  <script type="application/json" id="order-plan-data" set:html={JSON.stringify(orderPlans)} />
  <script is:inline define:vars={{ whatsappNumber: site.whatsapp.replace(/\D/g, ""), isDe }}>
    const orderModal = document.getElementById("order-modal");
    const orderForm = document.getElementById("order-form");
    const orderError = document.getElementById("order-error");
    const planSelect = orderForm?.elements.namedItem("plan");
    const quantityInput = orderForm?.elements.namedItem("quantity");
    const planDataNode = document.getElementById("order-plan-data");
    const orderPlans = planDataNode ? JSON.parse(planDataNode.textContent || "[]") : [];
    const summary = {
      name: document.querySelector('[data-summary="name"]'),
      duration: document.querySelector('[data-summary="duration"]'),
      unit: document.querySelector('[data-summary="unit"]'),
      quantity: document.querySelector('[data-summary="quantity"]'),
      total: document.querySelector('[data-summary="total"]'),
    };

    const formatChf = (amount) => `${amount} CHF`;
    const selectedPlan = () => orderPlans.find((plan) => plan.id === planSelect?.value) || orderPlans[0];
    const selectedQuantity = () => Math.max(1, Number.parseInt(quantityInput?.value || "1", 10) || 1);

    const updateSummary = () => {
      const plan = selectedPlan();
      const quantity = selectedQuantity();
      if (!plan) return;
      if (summary.name) summary.name.textContent = plan.name;
      if (summary.duration) summary.duration.textContent = plan.duration;
      if (summary.unit) summary.unit.textContent = formatChf(plan.priceChf);
      if (summary.quantity) summary.quantity.textContent = String(quantity);
      if (summary.total) summary.total.textContent = formatChf(plan.priceChf * quantity);
    };

    const openOrder = (planId) => {
      if (!orderModal || !orderForm || !planSelect) return;
      planSelect.value = planId;
      if (quantityInput) quantityInput.value = "1";
      if (orderError) orderError.hidden = true;
      updateSummary();
      orderModal.hidden = false;
      document.body.classList.add("modal-open");
      orderForm.querySelector('input[name="email"]')?.focus();
    };

    const closeOrder = () => {
      if (!orderModal) return;
      orderModal.hidden = true;
      document.body.classList.remove("modal-open");
    };

    document.querySelectorAll(".order-trigger").forEach((button) => {
      button.addEventListener("click", () => openOrder(button.dataset.planId));
    });
    document.querySelectorAll("[data-order-close]").forEach((button) => button.addEventListener("click", closeOrder));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !orderModal?.hidden) closeOrder();
    });
    planSelect?.addEventListener("change", updateSummary);
    quantityInput?.addEventListener("input", updateSummary);

    orderForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const formData = new FormData(orderForm);
      const email = String(formData.get("email") || "").trim();
      const payment = String(formData.get("payment") || "").trim();
      const quantity = selectedQuantity();
      const plan = selectedPlan();
      const emailIsValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      if (!plan || !emailIsValid || quantity < 1 || !Number.isInteger(quantity) || !payment) {
        if (orderError) {
          orderError.textContent = isDe
            ? "Bitte geben Sie eine gueltige E-Mail-Adresse, Anzahl und Zahlungsmethode ein."
            : "Veuillez saisir une adresse e-mail valide, une quantite et un mode de paiement.";
          orderError.hidden = false;
        }
        return;
      }

      const paymentLabel = isDe
        ? {
            "Credit or debit card": "Kredit- oder Debitkarte",
            "Bank transfer": "Bankueberweisung",
          }[payment] || payment
        : {
            "Credit or debit card": "Carte de credit ou de debit",
            "Bank transfer": "Virement bancaire",
          }[payment] || payment;
      const total = plan.priceChf * quantity;
      const priceLine = quantity > 1 ? `${total} CHF (${plan.priceChf} CHF x ${quantity})` : `${total} CHF`;
      const message = isDe
        ? [
            "Hallo: schweiz-iptv.net",
            `E-Mail-Adresse: ${email}`,
            `Abo: ${plan.name}`,
            `Anzahl: ${quantity}`,
            `Preis: ${priceLine}`,
            `Zahlungsmethode: ${paymentLabel}`,
          ].join("\n")
        : [
            "Bonjour : schweiz-iptv.net",
            `Adresse e-mail: ${email}`,
            `Abonnement : ${plan.name}`,
            `Quantite : ${quantity}`,
            `Prix : ${priceLine}`,
            `Mode de paiement : ${paymentLabel}`,
          ].join("\n");

      window.location.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;
    });
  </script>
</section>
