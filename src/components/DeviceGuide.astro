---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
  steps: string[];
}

const { eyebrow, title, description, steps } = Astro.props;
const isDe = !Astro.url.pathname.startsWith("/fr/");
---

<section class="page-hero">
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  <p>{description}</p>
</section>

<section class="section devices">
  <div class="steps">
    {steps.map((step, index) => (
      <article>
        <strong>{index + 1}</strong>
        <h2>{step}</h2>
        <p>{isDe ? "Der Support hilft Ihnen per WhatsApp, wenn Sie bei diesem Schritt nicht weiterkommen." : "Le support vous accompagne par WhatsApp si vous bloquez à cette étape."}</p>
      </article>
    ))}
  </div>
</section>
