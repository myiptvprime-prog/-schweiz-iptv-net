---
import { channelGroups, devices, site } from "../data/site";
import { deChannelGroups, deDevices } from "../data/de";

const deviceDescriptions: Record<string, string> = {
  "Smart TV": "Samsung, LG et applications IPTV compatibles.",
  Android: "Android TV, box Android, smartphone et tablette.",
  "iOS / tvOS": "iPhone, iPad et Apple TV selon application.",
  Windows: "Lecture sur PC avec une application compatible.",
  "Fire TV": "Installation sur Fire TV Stick compatible.",
  "Boîtier IPTV": "MAG et autres boîtiers IPTV compatibles.",
};

const deDeviceDescriptions: Record<string, string> = {
  "Smart TV": "Samsung, LG und kompatible IPTV Apps.",
  Android: "Android TV, Android Box, Smartphone und Tablet.",
  "iOS / tvOS": "iPhone, iPad und Apple TV mit passender App.",
  Windows: "Wiedergabe am PC mit kompatiblem Player.",
  "Fire TV": "Installation auf kompatiblem Fire TV Stick.",
  "IPTV Box": "MAG und andere kompatible IPTV Boxen.",
};

const deviceIcons = ["▣", "▤", "○", "⌘", "▶", "▥"];
const isDe = !Astro.url.pathname.startsWith("/fr/");
const activeDevices = isDe ? deDevices : devices;
const activeDeviceDescriptions = isDe ? deDeviceDescriptions : deviceDescriptions;
const activeChannelGroups = isDe ? deChannelGroups : channelGroups;
---

<section class="section advantages">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "Vorteile IPTV Schweiz" : "Avantages IPTV Suisse"}</p>
    <h2>{isDe ? "Warum ein IPTV Abo in der Schweiz wählen?" : "Pourquoi choisir un abonnement IPTV Suisse ?"}</h2>
    <p>
      {isDe
        ? "Unser IPTV Angebot für die Schweiz legt Wert auf nützliche Sender, Bildqualität, kompatible Geräte, stabile Nutzung und erreichbaren Support."
        : "Notre service Schweiz IPTV met l'accent sur les chaînes TV utiles, la qualité d'image, les appareils compatibles, la stabilité et un support client disponible pour vous accompagner."}
    </p>
  </div>
  <div class="advantage-grid">
    <article>
      <span>4K</span>
      <h3>Ultra HD 4K</h3>
      <p>{isDe ? "Geniessen Sie Bildqualität bis Ultra HD 4K auf kompatiblen Geräten mit einer klaren und angenehmen Wiedergabe." : "Profitez d'une qualité d'image jusqu'en Ultra HD 4K sur les appareils compatibles, avec une expérience de visionnage claire et agréable."}</p>
    </article>
    <article>
      <span>HD</span>
      <h3>{isDe ? "Stabiles Streaming" : "Streaming fluide"}</h3>
      <p>{isDe ? "Die Nutzung ist auf eine möglichst stabile Wiedergabe ausgelegt, wenn Ihre Internetverbindung passend und zuverlässig ist." : "Une expérience pensée pour offrir une lecture stable et fluide, avec moins d'interruptions lorsque votre connexion Internet est adaptée."}</p>
    </article>
    <article>
      <span>+</span>
      <h3>{isDe ? "Kostenlose Updates" : "Mise à jour quotidienne gratuite"}</h3>
      <p>{isDe ? "Der Katalog wird regelmässig gepflegt, damit Sender, Kategorien und Programme möglichst aktuell bleiben." : "Le contenu est régulièrement actualisé afin de maintenir une sélection de chaînes et de programmes aussi complète que possible."}</p>
    </article>
  </div>
</section>

<section class="contact-band" id="contact">
  <div>
    <p class="eyebrow">{isDe ? "IPTV Support Schweiz" : "Support IPTV Suisse"}</p>
    <h2>{isDe ? "Brauchen Sie Hilfe bei der Auswahl?" : "Besoin d'aide pour choisir votre abonnement ?"}</h2>
    <p>{isDe ? "Kontaktieren Sie den Support per WhatsApp oder E-Mail, um Ihr Gerät, die IPTV Angebote und die Multi-Screen-Bedingungen zu prüfen." : "Contactez le support par WhatsApp ou e-mail pour vérifier votre appareil, les offres IPTV disponibles et les conditions Multi Écran."}</p>
  </div>
  <div class="contact-actions">
    <a
      class="button primary"
      href={`https://wa.me/${site.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(
        isDe
          ? "Hello, Schweiz IPTV. Ich interessiere mich fuer ein IPTV Abo Schweiz. Bitte senden Sie mir Informationen und den Zahlungslink."
          : "Hello, Schweiz IPTV. Je viens du site schweiz-IPTV.net. Je souhaite des informations sur un abonnement IPTV Suisse et le lien de paiement."
      )}`}
    >
      WhatsApp
    </a>
    <a class="button secondary" href={`mailto:${site.email}`}>E-mail</a>
  </div>
</section>

<section class="section compatible-devices" id="appareils">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "Kompatible Geräte" : "Appareils compatibles"}</p>
    <h2>{isDe ? "Auf welchen Geräten funktioniert IPTV?" : "Sur quels appareils utiliser notre IPTV ?"}</h2>
    <p>
      {isDe
        ? "Ihr IPTV Abo kann auf verschiedenen kompatiblen Geräten genutzt werden, je nach App, gewähltem Angebot und technischen Voraussetzungen."
        : "Votre abonnement IPTV peut être utilisé sur différents appareils compatibles, selon l'application installée, la formule choisie et les conditions techniques de votre équipement."}
    </p>
  </div>
  <div class="device-card-row">
    {activeDevices.map((device, index) => (
      <article>
        <span>{deviceIcons[index]}</span>
        <h3>{device}</h3>
        <p>{activeDeviceDescriptions[device]}</p>
      </article>
    ))}
  </div>
</section>

<section class="section channels" id="chaines">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "Sender & VOD" : "Chaînes & VOD"}</p>
    <h2>{isDe ? "Sender, Replay und VOD für Ihr IPTV Abo" : "Chaînes, replay et VOD pour votre abonnement IPTV"}</h2>
    <p>
      {isDe
        ? "Prüfen Sie die wichtigsten Kategorien nach Sprache, Land und Nutzung, bevor Sie Ihr IPTV Abo Schweiz auswählen."
        : "Vérifiez les principales catégories par langue, pays et usage avant de choisir votre abonnement IPTV Suisse."}
    </p>
  </div>
  <div class="channel-grid">
    {activeChannelGroups.map(([title, text]) => (
      <article>
        <h3>{title}</h3>
        <p>{text}</p>
      </article>
    ))}
  </div>
</section>

<section class="section how-it-works" id="installation">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "IPTV Aktivierung" : "Activation IPTV"}</p>
    <h2>{isDe ? "So nutzen Sie Ihr IPTV Abo in der Schweiz" : "Comment utiliser votre abonnement IPTV Suisse ?"}</h2>
    <p>{isDe ? "In wenigen Schritten wählen Sie das passende Abo, erhalten Ihre Zugangsdaten und richten Ihr kompatibles Gerät ein." : "Quelques étapes simples permettent de choisir votre formule, recevoir vos accès et configurer votre appareil compatible."}</p>
  </div>
  <div class="steps four">
    <article><strong>1</strong><h3>{isDe ? "Abo auswählen" : "Choisissez votre abonnement"}</h3><p>{isDe ? "Wählen Sie das IPTV Abo nach Laufzeit, Anzahl Bildschirme und gewünschten Optionen." : "Sélectionnez le forfait IPTV qui correspond le mieux à vos besoins, en fonction de la durée, du nombre d'écrans et des options disponibles."}</p></article>
    <article><strong>2</strong><h3>{isDe ? "Zugangsdaten erhalten" : "Recevez vos accès par e-mail"}</h3><p>{isDe ? "Nach der Bestellung erhalten Sie die Informationen zur Aktivierung per E-Mail oder über den vereinbarten Kontaktkanal." : "Après votre commande, les informations nécessaires à l'activation sont envoyées directement à l'adresse e-mail indiquée lors de l'achat."}</p></article>
    <article><strong>3</strong><h3>{isDe ? "App installieren" : "Installez l'application"}</h3><p>{isDe ? "Installieren Sie eine kompatible IPTV App und folgen Sie den bereitgestellten Schritten zur Einrichtung." : "Téléchargez l'application compatible avec votre appareil et suivez les instructions fournies pour configurer facilement votre accès IPTV."}</p></article>
    <article><strong>4</strong><h3>{isDe ? "IPTV nutzen" : "Profitez de votre abonnement"}</h3><p>{isDe ? "Nach der Konfiguration nutzen Sie Ihr Abo mit Sendern, Replay und VOD auf dem kompatiblen Gerät." : "Une fois la configuration terminée, profitez de votre service IPTV et de votre sélection de chaînes et contenus sur votre appareil compatible."}</p></article>
  </div>
</section>

<section class="section choice">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "Richtig wählen" : "Bien choisir"}</p>
    <h2>{isDe ? "Wie wählt man ein IPTV Abo in der Schweiz?" : "Comment choisir un abonnement IPTV Suisse ?"}</h2>
    <p>{isDe ? "Vergleichen Sie nicht nur den Preis. Wichtig sind Stabilität, Katalog, kompatible Geräte, Support und klare Bedingungen." : "Avant de choisir, comparez plus que le prix: fiabilité, contenus, compatibilité avec vos appareils et qualité du support client sont essentiels."}</p>
  </div>
  <div class="criteria-grid">
    <article><h3>{isDe ? "Stabilität zu Spitzenzeiten" : "Stabilité du service aux heures de pointe"}</h3><p>{isDe ? "Achten Sie auf eine Lösung, die auch abends und am Wochenende stabil bleibt, abhängig von Ihrer Internetverbindung." : "Privilégiez une solution conçue pour offrir une expérience stable pendant les périodes où la demande est plus importante, tout en tenant compte de votre connexion Internet."}</p></article>
    <article><h3>{isDe ? "Schweizer Sender prüfen" : "Vérifiez les chaînes suisses incluses"}</h3><p>{isDe ? "Prüfen Sie vor dem Abo, ob die gewünschten Schweizer und internationalen Sender im gewählten Angebot enthalten sind." : "Avant de choisir votre abonnement, vérifiez que les chaînes suisses et les contenus que vous souhaitez regarder sont bien inclus dans l'offre sélectionnée."}</p></article>
    <article><h3>{isDe ? "Geräte-Kompatibilität prüfen" : "Vérifiez la compatibilité avec vos appareils"}</h3><p>{isDe ? "Stellen Sie sicher, dass Smart TV, Android, iOS/tvOS, Windows, Fire TV oder IPTV Box die benötigte App unterstützt." : "Assurez-vous que votre Smart TV, appareil Android, iOS/tvOS, Windows, Fire TV ou boîtier compatible peut utiliser l'application nécessaire."}</p></article>
    <article><h3>{isDe ? "Abo-Bedingungen vergleichen" : "Comparez les conditions de l'abonnement"}</h3><p>{isDe ? "Vergleichen Sie Laufzeit, Anzahl Bildschirme, Aktivierung, Support und Garantie, nicht nur den Endpreis." : "Ne regardez pas uniquement le prix. Comparez aussi la durée, le nombre d'écrans, les conditions d'utilisation, l'activation et le support client."}</p></article>
  </div>
</section>

<section class="section buyer-check" id="legal">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "Vor dem Kauf" : "Avant achat"}</p>
    <h2>{isDe ? "Was sollten Sie vor dem IPTV Kauf prüfen?" : "Que vérifier avant d'acheter votre abonnement IPTV ?"}</h2>
  </div>
  <div class="faq-list">
    <details open><summary>{isDe ? "Brauche ich eine stabile Internetverbindung?" : "Ai-je besoin d'une connexion Internet ?"}</summary><p>{isDe ? "Ja. Eine stabile Verbindung ist wichtig, damit IPTV sauber funktioniert. Qualität und Stabilität hängen auch von Ihrer Leitung ab." : "Oui. Une connexion Internet stable est nécessaire pour utiliser un service IPTV dans de bonnes conditions. La qualité de votre expérience dépend notamment de la vitesse et de la stabilité de votre connexion."}</p></details>
    <details><summary>{isDe ? "Kann ich Schweizer und internationale Sender schauen?" : "Puis-je regarder des chaînes suisses et internationales ?"}</summary><p>{isDe ? "Die Verfügbarkeit hängt vom gewählten Angebot und den enthaltenen Sendern ab. Prüfen Sie die Liste vor der Bestellung." : "La disponibilité dépend du forfait choisi et des chaînes incluses dans celui-ci. Consultez la liste des chaînes de l'offre avant de commander pour vérifier que les contenus souhaités sont disponibles."}</p></details>
    <details><summary>{isDe ? "Wie schnell erhalte ich meine Zugangsdaten?" : "Combien de temps faut-il pour recevoir mes accès ?"}</summary><p>{isDe ? "Die Zugangsdaten werden nach Bestätigung der Bestellung in der Regel per E-Mail versendet, mit einer angekündigten Aktivierung bis zu 15 Minuten." : "Les informations d'accès sont généralement envoyées par e-mail après la validation de la commande, avec un délai annoncé de 15 minutes maximum."}</p></details>
  </div>
</section>

<section class="section faq" id="faq">
  <div class="section-title">
    <p class="eyebrow">{isDe ? "FAQ IPTV Schweiz" : "FAQ IPTV Suisse"}</p>
    <h2>{isDe ? "Häufige Fragen zu IPTV in der Schweiz" : "Questions fréquentes sur IPTV Suisse"}</h2>
  </div>
  <div class="faq-list">
    <details open><summary>{isDe ? "Was ist IPTV in der Schweiz?" : "Qu'est-ce que l'IPTV Suisse ?"}</summary><p>{isDe ? "IPTV ermöglicht das Fernsehen und weitere Inhalte über eine Internetverbindung. Welche Sender verfügbar sind, hängt vom Dienst und vom gewählten Abo ab." : "L'IPTV permet de regarder des programmes télévisés et d'autres contenus via une connexion Internet plutôt que par les méthodes traditionnelles de diffusion. La disponibilité des chaînes dépend du service et du forfait choisi."}</p></details>
    <details><summary>{isDe ? "Welches IPTV Abo Schweiz soll ich wählen?" : "Quel abonnement IPTV Suisse choisir ?"}</summary><p>{isDe ? "Vergleichen Sie Laufzeit, Bildschirme, nützliche Sender, VOD, Replay, Support und den monatlichen Preis." : "Pour comparer les offres, regardez la durée incluse, le nombre d'écrans, les chaînes utiles, la VOD, le replay, le support et le prix mensuel équivalent."}</p></details>
    <details><summary>{isDe ? "Welche Geräte sind kompatibel?" : "Quels sont les appareils compatibles ?"}</summary><p>{isDe ? "Je nach App und Angebot funktioniert IPTV auf Smart TV, Android, iOS/tvOS, Windows, Fire TV und kompatiblen IPTV Boxen." : "Selon l'application utilisée et le forfait choisi, l'IPTV peut être accessible sur différents appareils compatibles, notamment les Smart TV, Android, iOS/tvOS, Windows, Fire TV et certains boîtiers IPTV."}</p></details>
    <details><summary>{isDe ? "Wie lange dauert die Aktivierung?" : "Combien de temps prend l'activation ?"}</summary><p>{isDe ? "Nach Bestätigung der Bestellung ist die Aktivierung mit Versand der Zugangsdaten in der Regel innerhalb von bis zu 15 Minuten vorgesehen." : "Après la validation de la commande, l'activation et l'envoi des informations d'accès sont prévus dans un délai pouvant aller jusqu'à 15 minutes, selon le traitement de la commande."}</p></details>
    <details><summary>{isDe ? "Wie kontaktiere ich den Support?" : "Comment puis-je contacter le support ?"}</summary><p>{isDe ? "Der Support hilft bei Installation, Einrichtung und Fragen zum Abo. Sie erreichen uns per WhatsApp oder E-Mail." : "Notre support client est disponible pour vous accompagner lors de l'installation, de la configuration et en cas de problème lié à votre abonnement. Vous pouvez nous contacter par WhatsApp ou e-mail."}</p></details>
    <details><summary>{isDe ? "Kann ich mehrere Geräte nutzen?" : "Puis-je utiliser le service sur plusieurs appareils ?"}</summary><p>{isDe ? "Das hängt vom gewählten Angebot ab. Multi-Screen-Angebote sind für Nutzer gedacht, die auf mehreren Bildschirmen schauen möchten." : "Cela dépend du forfait choisi. Les offres Multi Écran sont conçues pour les clients qui souhaitent utiliser leur abonnement sur plusieurs écrans, conformément aux conditions de l'offre sélectionnée."}</p></details>
    <details><summary>{isDe ? "Ist IPTV in der Schweiz legal?" : "L'IPTV est-elle légale en Suisse ?"}</summary><p>{isDe ? "Die rechtliche Bewertung hängt unter anderem von Inhalten, Rechten und Bedingungen ab. Prüfen Sie die Angaben des Angebots vor einem Abo." : "La légalité dépend notamment des droits de diffusion et des contenus proposés. Nous recommandons de vérifier les conditions de l'offre et la disponibilité des chaînes avant tout abonnement."}</p></details>
  </div>
</section>
