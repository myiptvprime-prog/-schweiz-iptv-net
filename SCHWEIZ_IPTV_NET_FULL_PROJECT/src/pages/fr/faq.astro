---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { faq } from "../../data/site";
import "../../styles/global.css";
---

<BaseLayout title="FAQ IPTV Suisse | Questions sur abonnement, appareils et support" description="Réponses aux questions fréquentes sur IPTV Suisse: abonnement, Smart TV, Android, iOS, replay, VOD, support 24/7 et remboursement 48h.">
  <Header />
  <main>
    <section class="page-hero">
      <p class="eyebrow">FAQ IPTV Suisse</p>
      <h1>Questions fréquentes sur l'abonnement IPTV Suisse</h1>
    </section>
    <section class="section faq-list">
      {faq.map((item) => (
        <details open>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>
  </main>
  <Footer />
</BaseLayout>
