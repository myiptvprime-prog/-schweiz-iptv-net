---
import { features } from "../data/site";
import { deFeatures } from "../data/de";

const activeFeatures = Astro.url.pathname.startsWith("/fr/") ? features : deFeatures;

const paths: Record<string, string> = {
  channels: "M5 8h14M5 12h14M5 16h14M4 5h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z",
  films: "M4 4h16v16H4zM8 4v16M16 4v16M4 9h4M16 9h4M4 15h4M16 15h4",
  support: "M4 12a8 8 0 0 1 16 0v4a3 3 0 0 1-3 3h-2M4 12v4a3 3 0 0 0 3 3h2M9 19v-6H6M15 19v-6h3",
  guarantee: "M12 3 20 7v5c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V7l8-4ZM9 12l2 2 4-5",
};
---

<section class="section feature-section">
  <div class="feature-grid">
    {activeFeatures.map((feature) => (
      <article class="feature-card">
        <span class="feature-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d={paths[feature.icon]} />
          </svg>
        </span>
        <h2>{feature.title}</h2>
        <p>{feature.text}</p>
      </article>
    ))}
  </div>
</section>
